#!/usr/bin/env bash
# titan-shell: user-facing control of Titan's Quickshell desktop shell (config "umbra").
# Every IPC call is time-limited: a hung shell must not hang the caller.
set -euo pipefail
root=$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
config=umbra
usage() {
 cat <<'EOF'
Usage: titan-shell COMMAND [ARGS]

  status              JSON status; exit 1 if the shell does not respond
  restart             Replace the running shell (escalates if it hangs)
  ipc METHOD [ARG…]   Call a shell IPC function, e.g. `ipc settings appearance`
  functions           List the shell's IPC functions
  log [-f]            Show the current shell log (-f follows it)
  open PANEL          controls, notifications, launcher, themes, wallpapers,
                      media, session, island, clock, or settings [SECTION]
  close               Close any open panel
  help                Show this help
EOF
}
call() { timeout 5 qs -c "$config" ipc call shell "$@"; }
case "${1:-help}" in
 status)
  if ! call status; then echo "titan-shell: shell is not responding; try: titan-shell restart" >&2; exit 1; fi
  echo ;;
 restart) exec "$root/scripts/shell-restart" ;;
 ipc) shift; [[ $# -ge 1 ]] || { usage >&2; exit 2; }; call "$@" ;;
 functions) timeout 5 qs -c "$config" ipc show ;;
 log)
  if [[ ${2:-} == -f ]]; then exec qs -c "$config" log -f; fi
  timeout 5 qs -c "$config" log ;;
 open)
  panel=${2:-}; case $panel in
   controls|notifications|launcher|themes|wallpapers|media|session|island|clock) call "$panel" ;;
   settings) call settings "${3:-}" ;;
   *) usage >&2; exit 2 ;;
  esac ;;
 close) call close ;;
 help|-h|--help) usage ;;
 *) usage >&2; exit 2 ;;
esac
