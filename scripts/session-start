#!/usr/bin/env bash
set -euo pipefail
export XDG_CURRENT_DESKTOP=Hyprland XDG_SESSION_TYPE=wayland
systemctl --user import-environment WAYLAND_DISPLAY HYPRLAND_INSTANCE_SIGNATURE XDG_CURRENT_DESKTOP XDG_SESSION_TYPE
dbus-update-activation-environment --systemd WAYLAND_DISPLAY HYPRLAND_INSTANCE_SIGNATURE XDG_CURRENT_DESKTOP XDG_SESSION_TYPE
# Always-awake policy: no idle daemon or automatic DPMS/lock timers.
# Manual locking remains available through scripts/lock.
if ! pgrep -f '^/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1' >/dev/null; then
 /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &
fi
root=$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
export TITAN_ROOT=$root
"$root/bin/workflow" shell-init
if command -v cliphist >/dev/null; then "$root/bin/workflow" clipboard-start; fi
# Redraw when this session's VT becomes active again (docs/lock-recovery.md).
systemd-cat -t titan-vt-redraw "$root/scripts/vt-redraw" &
exec qs -n -d -c umbra
