#!/usr/bin/env bash
# apply-theme [THEME_ID]: generate Kitty and Hyprland colours from the palette
# catalog and record the choice in ~/.config/titan/preferences.json. Without an
# argument the current theme is regenerated. Generated files live in
# ~/.local/state/titan/generated and are never tracked in Git.
set -euo pipefail
root=$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
python - "$root" "${1:-}" <<'PY'
import json, os, signal, sys, tempfile, pathlib
sys.path.insert(0, sys.argv[1] + '/lib/titan')
from paths import CONFIG, GENERATED, PREFERENCES, THEME_DIR, preferences
palettes = json.loads((THEME_DIR/'palettes.json').read_text())
wanted = sys.argv[2] or preferences().get('theme', 'graphite')
p = next((p for p in palettes if p['id'] == wanted), None)
if p is None: raise SystemExit('Unknown palette: ' + wanted)
def atomic(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(dir=path.parent, prefix='.' + path.name)
    try:
        with os.fdopen(fd, 'w') as f: f.write(text)
        os.replace(name, path)
    finally:
        if os.path.exists(name): os.unlink(name)
colors = [p['surface'], *p['swatches'], p['text'], p['muted'], *p['swatches'], p['text']]
kitty = (f"# Generated by apply-theme from palette '{p['id']}'. Do not edit.\n"
         f"background {p['background']}\nforeground {p['text']}\ncursor {p['accent']}\n"
         f"selection_background {p['raised']}\nselection_foreground {p['text']}\n"
         + ''.join(f'color{i} {c}\n' for i, c in enumerate(colors)))
atomic(GENERATED/'kitty-theme.conf', kitty)
atomic(GENERATED/'hypr-theme.lua', f"-- Generated by apply-theme from palette '{p['id']}'. Do not edit.\n"
       'hl.config({general={col={active_border="rgba(' + p['accent'][1:] + 'ff)",inactive_border="rgba(' + p['raised'][1:] + 'ff)"}}})\n')
# Record the choice in the user layer; only an explicit theme change resets the accent.
CONFIG.mkdir(parents=True, exist_ok=True)
prefs = preferences()
if sys.argv[2] and prefs.get('theme') != p['id']: prefs['accent'] = 'theme'
if sys.argv[2]: prefs['theme'] = p['id']
current = json.loads(PREFERENCES.read_text()) if PREFERENCES.exists() else None
if prefs != current:
    atomic(PREFERENCES, json.dumps(prefs, indent=2) + '\n')
# Kitty reloads its configuration on SIGUSR1. Only signal this user's processes.
for proc in pathlib.Path('/proc').iterdir():
    if not proc.name.isdigit(): continue
    try:
        if proc.stat().st_uid == os.getuid() and (proc/'comm').read_text().strip() == 'kitty':
            os.kill(int(proc.name), signal.SIGUSR1)
    except (OSError, ProcessLookupError): pass
PY
if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
 hyprctl reload >/dev/null
fi
