#!/usr/bin/env bash
# titan: the user-facing Titan command. Desktop operations live in
# scripts/workflow and the shell in titan-shell; this adds versioning,
# migrations and updates on top and passes the rest through.
set -euo pipefail
root=$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
export TITAN_ROOT=$root
state=${XDG_STATE_HOME:-$HOME/.local/state}/titan
marks=$state/migrations

usage() {
 cat <<'EOF'
Usage: titan COMMAND [ARGS]

  version                 Titan version and checkout
  migrate                 Run pending migrations (safe to repeat)
  migrate --status        List migrations and whether each has run
  setup                   Per-user first-run setup (idempotent; never overwrites)
  update [--no-system]    Snapshot, update Titan and Arch packages, migrate, check
  doctor                  Health check
  hardware [--json|--packages]  Read-only hardware inventory and installer profile
  theme [list|current|ID] Show or apply a theme
  settings …              Same as: scripts/workflow settings …
  wallpaper …             Same as: scripts/workflow wallpaper …
  shell …                 Same as: titan-shell …
  help                    Show this help
EOF
}

migrations() { find "$root/migrations" -maxdepth 1 -name '*.sh' -printf '%f\n' | sort -n; }

migrate() {
 mkdir -p "$marks"
 if [[ ${1:-} == --status ]]; then
  while read -r m; do [[ -e $marks/$m ]] && echo "done     $m" || echo "pending  $m"; done < <(migrations)
  return
 fi
 # A fresh install starts at the current layout: record every migration as done.
 if [[ ${1:-} == --mark-all ]]; then
  while read -r m; do touch "$marks/$m"; done < <(migrations); return
 fi
 local ran=0
 while read -r m; do
  [[ -e $marks/$m ]] && continue
  echo "Migration $m"
  if ! bash "$root/migrations/$m"; then echo "titan: migration $m failed; nothing after it was run" >&2; exit 1; fi
  touch "$marks/$m"; ran=$((ran+1))
 done < <(migrations)
 ((ran)) && echo "$ran migration(s) applied." || echo "No pending migrations."
}

setup() {
 local config=${XDG_CONFIG_HOME:-$HOME/.config} fresh=1
 # titan-session creates the directory and setup.log before calling us.
 # Those alone are not an existing install; running legacy migrations on a
 # fresh login would mark Welcome as already dismissed.
 if [[ -d $state && -n $(find "$state" -mindepth 1 -maxdepth 1 ! -name setup.log -print -quit) ]]; then fresh=0; fi
 mkdir -p "$config/titan" "$state"; chmod 700 "$config/titan" "$state"
 # The user layer: created once, then only the user (or a migration) changes it.
 [[ -e $config/titan/hypr.lua ]] || printf -- '-- Your Hyprland overrides, loaded after Titan defaults.\n' >"$config/titan/hypr.lua"
 [[ -e $config/titan/kitty.conf ]] || printf '# Your Kitty overrides, loaded after Titan defaults.\n' >"$config/titan/kitty.conf"
 # Application defaults are copied once and then belong to the user.
 [[ -e $config/mimeapps.list || -L $config/mimeapps.list ]] || cp "$root/default/mimeapps.list" "$config/mimeapps.list"
 local gtk; for gtk in gtk-3.0 gtk-4.0; do
  [[ -e $config/$gtk/settings.ini || -L $config/$gtk ]] || { mkdir -p "$config/$gtk"; cp "$root/config/$gtk/settings.ini" "$config/$gtk/"; }
 done
 # Package mode: a thin Kitty config that loads Titan's (the checkout links it instead).
 if [[ ! -e $config/kitty/kitty.conf && ! -L $config/kitty ]]; then
  mkdir -p "$config/kitty"; printf '# Titan defaults first; put your changes in ~/.config/titan/kitty.conf.\ninclude %s/config/kitty/kitty.conf\n' "$root" >"$config/kitty/kitty.conf"
 fi
 if ((fresh)); then migrate --mark-all; else migrate; fi
 "$root/scripts/apply-theme"
 if command -v gsettings >/dev/null && gsettings list-schemas 2>/dev/null | grep -qx org.gnome.desktop.interface; then
  gsettings set org.gnome.desktop.interface color-scheme prefer-dark || true
  gsettings set org.gnome.desktop.interface gtk-theme Adwaita-dark || true
  gsettings set org.gnome.desktop.interface font-name 'Inter 10' || true
 fi
 systemctl --user enable --now pipewire.socket pipewire-pulse.socket wireplumber.service >/dev/null 2>&1 || true
 cat "$root/version" >"$state/setup-version"
 echo "Titan $(cat "$root/version") is set up for $(id -un)."
}

update() {
 local system=1; [[ ${1:-} == --no-system ]] && system=0
 exec 9>"$state/update.lock"; flock -n 9 || { echo "titan: another update is running" >&2; exit 1; }
 echo "Titan $(cat "$root/version") — update"
 # Preflight: never start half-way into a broken state.
 [[ -e /var/lib/pacman/db.lck ]] && { echo "titan: pacman is busy (/var/lib/pacman/db.lck)" >&2; exit 1; }
 local free; free=$(df --output=avail -k / | tail -1)
 (( free > 2*1024*1024 )) || { echo "titan: less than 2 GiB free on /" >&2; exit 1; }
 local checkout=0; [[ -d $root/.git ]] && checkout=1
 if ((checkout)) && [[ -n $(git -C "$root" status --porcelain --untracked-files=no) ]]; then
  echo "titan: the Titan checkout has local changes; commit or move them first:" >&2
  git -C "$root" status --short --untracked-files=no >&2; exit 1
 fi
 # Snapshot first when Snapper is configured (scripts/install-snapshots).
 if command -v snapper >/dev/null && snapper list-configs 2>/dev/null | grep -q '^root '; then
  sudo snapper -c root create -c number -d "titan update $(date -Is)" && echo "Snapshot taken."
 else
  echo "No root snapshot configured (run scripts/install-snapshots to enable); continuing."
 fi
 local before; before=$( ((checkout)) && git -C "$root" rev-parse HEAD || cat "$root/version")
 # A checkout updates through Git; a packaged Titan updates with pacman below.
 if ((checkout)) && git -C "$root" rev-parse --abbrev-ref '@{upstream}' >/dev/null 2>&1; then
  git -C "$root" pull --ff-only
 fi
 if ((system)); then
  sudo pacman -Syu   # full upgrade only: Arch does not support partial upgrades
 fi
 migrate
 "$root/scripts/doctor" >/dev/null && echo "Doctor: OK" || echo "Doctor reported problems: run titan doctor" >&2
 local after; after=$( ((checkout)) && git -C "$root" rev-parse HEAD || cat "$root/version")
 if [[ $after != "$before" ]] && { ((!checkout)) || ! git -C "$root" diff --quiet "$before" HEAD -- config/quickshell; }; then
  "$root/scripts/titan-shell" restart && echo "Shell restarted."
 fi
 [[ -d /usr/lib/modules/$(uname -r) ]] || echo "The running kernel was updated: reboot when convenient."
 echo "Titan $(cat "$root/version") is up to date."
}

case "${1:-help}" in
 setup) setup ;;
 version)
  echo "Titan $(cat "$root/version") ($(git -C "$root" rev-parse --short HEAD 2>/dev/null || echo package), $root)" ;;
 migrate) shift; migrate "$@" ;;
 update) shift; update "$@" ;;
 doctor) exec "$root/scripts/doctor" ;;
 hardware) shift; exec "$root/scripts/titan-hardware" "$@" ;;
 theme)
  case "${2:-current}" in
   list) python3 -c "import json,sys;[print(p['id']) for p in json.load(open(sys.argv[1]))]" "$root/config/quickshell/umbra/theme/palettes.json" ;;
   current) python3 -c "import sys;sys.path.insert(0,sys.argv[1]);from paths import preferences;print(preferences()['theme'])" "$root/lib/titan" ;;
   *) exec "$root/scripts/apply-theme" "$2" ;;
  esac ;;
 settings|wallpaper) exec "$root/scripts/workflow" "$@" ;;
 shell) shift; exec "$root/scripts/titan-shell" "$@" ;;
 help|-h|--help) usage ;;
 *) usage >&2; exit 2 ;;
esac
