# Titan: defaults, shell, commands, scripts and migrations installed to /usr/share/titan.
# Build from this directory: makepkg -f   (see docs/distribution.md)
pkgname=titan
pkgver=0.3.0
pkgrel=1
# Maintainer: Cristian Adrian Paredez <itsalltheshade@gmail.com>
pkgdesc="Titan desktop: Hyprland + Quickshell defaults, shell, tools and migrations"
arch=('any')
url="https://github.com/ayoshade/titan"
license=('Apache-2.0' 'MIT')
depends=('bash' 'python' 'jq' 'hyprland' 'quickshell' 'kitty' 'hyprlock' 'wl-clipboard' 'libnotify')
optdepends=('titan-desktop: the complete Titan desktop package set'
            'snapper: snapshots before updates (scripts/install-snapshots)')
source=()
_root="$startdir/../.."

pkgver() { cat "$_root/version"; }

package() {
  local share="$pkgdir/usr/share/titan"
  install -d "$share"
  # Defaults and code only: user state never ships.
  cp -a --no-preserve=ownership "$_root"/{bin,config,scripts,lib,assets,migrations,default,packages,system,keys,installation,version} "$share/"
  find "$share" -name __pycache__ -prune -exec rm -rf {} +
  install -d "$pkgdir/usr/bin"
  for cmd in titan titan-shell titan-session; do
    ln -s "/usr/share/titan/bin/$cmd" "$pkgdir/usr/bin/$cmd"
  done
  # Quickshell finds its configuration in every XDG config directory.
  install -d "$pkgdir/etc/xdg/quickshell" "$pkgdir/etc/xdg/xdg-desktop-portal"
  ln -s /usr/share/titan/config/quickshell/umbra "$pkgdir/etc/xdg/quickshell/umbra"
  install -m644 "$_root/config/xdg-desktop-portal/hyprland-portals.conf" "$pkgdir/etc/xdg/xdg-desktop-portal/"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/wayland-sessions/titan.desktop" <<'DESKTOP'
[Desktop Entry]
Name=Titan
Comment=The Titan desktop (Hyprland and Quickshell)
Exec=titan-session
Type=Application
DesktopNames=Hyprland
DESKTOP
  install -Dm644 "$_root/NOTICE" "$pkgdir/usr/share/licenses/titan/NOTICE"
  install -Dm644 "$_root/agents/LICENSE.omarchy" "$pkgdir/usr/share/licenses/titan/LICENSE.omarchy"
  install -d "$pkgdir/usr/share/doc/titan"
  cp -a --no-preserve=ownership "$_root"/README.md "$_root"/docs "$pkgdir/usr/share/doc/titan/"
}
