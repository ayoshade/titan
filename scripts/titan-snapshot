#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
source "$root/lib/titan/boot.sh"
case ${1:-} in
 list)
  [[ $# == 1 || ( $# == 2 && $2 == --json ) ]] || { echo 'Usage: titan snapshot list [--json]' >&2; exit 2; }
  titan_snapshot_list ;;
 create)
  [[ $# == 1 || ( $# == 3 && $2 == --description ) ]] || { echo 'Usage: sudo titan snapshot create [--description TEXT]' >&2; exit 2; }
  titan_snapshot_create "${3:-Manual recovery preview}" ;;
 -h|--help|help) echo 'Usage: titan snapshot list [--json] | create [--description TEXT] (fresh Limine QEMU installs only)' ;;
 *) echo 'Usage: titan snapshot list [--json] | create [--description TEXT]' >&2; exit 2 ;;
esac
