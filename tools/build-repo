#!/usr/bin/env bash
# build-repo [--channel stable|edge] [--sign KEYID] [OUTDIR]
# Build the titan and titan-desktop packages from this checkout and publish
# them into a pacman repository directory (default ~/.cache/titan/repo/CHANNEL).
# Serve OUTDIR over HTTPS (or use it as file://) and add to /etc/pacman.conf:
#   [titan]
#   Server = https://YOUR-HOST/titan/$repo/CHANNEL      (or file:///path/to/OUTDIR)
# Unsigned repositories are for testing only; sign releases with --sign.
set -euo pipefail
root=$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
channel=stable sign=""
while (($#)); do
 case $1 in
  --channel) channel=$2; shift 2 ;;
  --sign) sign=$2; shift 2 ;;
  -h|--help) sed -n 2,9p "$0"; exit 0 ;;
  *) out=$1; shift ;;
 esac
done
[[ $channel == stable || $channel == edge ]] || { echo "build-repo: channel must be stable or edge" >&2; exit 2; }
out=${out:-${XDG_CACHE_HOME:-$HOME/.cache}/titan/repo/$channel}
mkdir -p "$out"
if [[ $channel == stable && -n $(git -C "$root" status --porcelain --untracked-files=no 2>/dev/null) ]]; then
 echo "build-repo: stable builds need a clean checkout (commit first, or use --channel edge)" >&2; exit 1
fi
signargs=(); [[ -n $sign ]] && signargs=(--sign --key "$sign")
for pkg in titan titan-desktop; do
 ( cd "$root/packaging/$pkg" && makepkg -f -d --noconfirm "${signargs[@]}" >/dev/null )
 file=$(cd "$root/packaging/$pkg" && ls -t "$pkg"-*.pkg.tar.zst | grep -v -- '-debug-' | head -1)
 cp "$root/packaging/$pkg/$file" "$out/"
 [[ -n $sign ]] && cp "$root/packaging/$pkg/$file.sig" "$out/"
 repoargs=(); [[ -n $sign ]] && repoargs=(--sign --key "$sign")
 repo-add -q -R "${repoargs[@]}" "$out/titan.db.tar.zst" "$out/$file"
 echo "  $file → $out"
done
echo "Repository '$channel' ready in $out (Titan $(cat "$root/version"))."
