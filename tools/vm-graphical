#!/usr/bin/env python3
"""Internal companion to vm-test --graphical; never starts a host desktop."""
import os
from pathlib import Path
import subprocess
import sys
import time
import shlex
import traceback

root = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(root / "lib/titan"))
from vm_qmp import Monitor

run = Path(os.environ["TITAN_VM_RUN"])
port = os.environ["TITAN_VM_SSH_PORT"]
user = f"titanuser{time.time_ns() % 100000}"
(run / "graphical-user").write_text(user + "\n")
ssh = ["ssh", "-q", "-i", str(run / "key"), "-p", port,
       "-o", "StrictHostKeyChecking=no", "-o", "UserKnownHostsFile=/dev/null",
       "-o", "ConnectTimeout=5", os.environ.get("TITAN_VM_SSH_USER", "tester") + "@127.0.0.1"]


def guest(command, check=True):
    return subprocess.run(ssh + ["cd / && " + command], text=True, capture_output=True, timeout=20, check=check)


def wait_for(command, seconds=60):
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        result = guest(command, check=False)
        if result.returncode == 0:
            return result.stdout
        time.sleep(2)
    raise RuntimeError(f"Guest check timed out: {command}\n{result.stdout}{result.stderr}")


try:
    monitor = Monitor(run / "qmp.sock")
    # An ephemeral password only for this throwaway VM; never use a host credential.
    guest(f"sudo useradd -m -s /bin/bash {user}; "
          f"printf '{user}:titanvm\\n' | sudo chpasswd; "
          "sudo pkill -KILL -x Hyprland || true; sudo pkill -KILL -x qs || true; "
          "sudo rm -f /var/lib/regreet/state.toml; "
          "sudo systemctl restart --no-block greetd")
    wait_for("pgrep -x regreet >/dev/null")
    time.sleep(8)
    width, height = monitor.screenshot(run / "greeter.png")
    print(f"Greeter captured: {run / 'greeter.png'}", flush=True)
    # ReGreet's custom-entry controls avoid depending on account/session
    # ordering in different package versions. Authentication remains real.
    monitor.click(width // 2 + 223, height // 2 - 36, width, height)
    monitor.click(width // 2, height // 2 - 36, width, height)
    monitor.key("ctrl", "a")
    monitor.type(user)
    monitor.key("tab")
    monitor.click(width // 2 + 223, height // 2 + 25, width, height)
    monitor.click(width // 2, height // 2 + 25, width, height)
    monitor.key("ctrl", "a")
    monitor.type("titan-session")
    monitor.key("tab")
    monitor.screenshot(run / "selection.png")
    monitor.click(width // 2 + 215, height // 2 + 86, width, height)
    time.sleep(2)
    monitor.screenshot(run / "login.png")
    monitor.click(width // 2, height // 2 + 25, width, height)
    monitor.key("ctrl", "a")
    monitor.type("titanvm")
    monitor.key("ret")
    wait_for(f"pgrep -u {user} -x Hyprland >/dev/null", 90)
    wait_for(f"pgrep -u {user} -x quickshell >/dev/null || pgrep -u {user} -x qs >/dev/null", 90)
    time.sleep(8)
    monitor.screenshot(run / "desktop.png")
    # SSH does not inherit Wayland's environment; read just its instance id.
    uid = guest(f"id -u {user}").stdout.strip()
    display = guest(f"sudo -u {user} find /run/user/{uid} -maxdepth 1 -type s -name 'wayland-*'").stdout.strip().splitlines()[0]
    user_prefix = f"sudo -H -u {user} env XDG_RUNTIME_DIR=/run/user/{uid} WAYLAND_DISPLAY={shlex.quote(Path(display).name)} "
    instances = guest(user_prefix + "hyprctl instances -j").stdout
    import json
    signature = json.loads(instances)[0]["instance"]
    prefix = user_prefix + f"HYPRLAND_INSTANCE_SIGNATURE={shlex.quote(signature)} "
    errors = guest(prefix + "hyprctl configerrors").stdout.strip()
    if errors:
        raise RuntimeError(f"Live Hyprland config errors: {errors}")
    guest(prefix + "hyprctl monitors -j")
    # IPC confirms QML instantiated, beyond just a process existing.
    status = json.loads(wait_for(user_prefix + "timeout 10 titan-shell status"))
    guest(f"sudo -u {user} test -e /home/{user}/.local/state/titan/setup-version && ! sudo -u {user} test -e /home/{user}/.local/state/titan/welcome-done")
    if status.get("panel") != "welcome":
        raise RuntimeError(f"Welcome did not open on first login: {status}")
    (run / "shell-status.json").write_text(json.dumps(status, indent=2) + "\n")
    print("PASS  Titan session sets up a fresh account on first login", flush=True)
    print("PASS  ReGreet login starts Hyprland and the live Titan shell", flush=True)

    # A real workflow keybinding: Super+Shift+Backspace toggles gaps, twice.
    def gaps():
        return json.loads(guest(prefix + "hyprctl getoption general:gaps_out -j").stdout)
    before = gaps()
    monitor.key("meta_l", "shift", "backspace")
    time.sleep(2)
    toggled = gaps()
    monitor.key("meta_l", "shift", "backspace")
    time.sleep(2)
    if toggled == before or gaps() != before:
        raise RuntimeError(f"Gaps keybinding did not toggle and restore: {before} {toggled} {gaps()}")
    print("PASS  workflow keybinding (Super+Shift+Backspace) toggles gaps and back", flush=True)

    # The lock screen: the real Super+Ctrl+L binding, judged by framebuffer pixels.
    def lock_frame(name):
        w, h, rgb = monitor.pixels(run / f"{name}.ppm")
        monitor.screenshot(run / f"{name}.png")
        background = (0x08, 0x09, 0x0b)
        lit = sum(1 for i in range(0, len(rgb), 3 * 7)
                  if abs(rgb[i] - background[0]) + abs(rgb[i + 1] - background[1]) + abs(rgb[i + 2] - background[2]) > 40)
        band = [rgb[(y * w + x) * 3:(y * w + x) * 3 + 3] for y in range(h // 2 + 100, h // 2 + 132) for x in range(w // 4, 3 * w // 4)]
        warning = sum(1 for p in band if p[0] > 120 and p[0] - p[1] > 40)
        return lit / (len(rgb) / 21), warning

    def locked():
        return guest(f"pgrep -u {user} -x hyprlock >/dev/null", check=False).returncode == 0

    monitor.key("meta_l", "ctrl", "l")
    wait_for(f"pgrep -u {user} -x hyprlock >/dev/null", 20)
    time.sleep(3)
    lit, _ = lock_frame("lock")
    if not 0.002 < lit < 0.5:
        raise RuntimeError(f"Lock screen is not visibly rendered (lit fraction {lit:.4f}); see lock.png")
    if not guest(f"sudo journalctl -b _UID={uid} -t titan-lock --no-pager -q | grep -q .", check=False).returncode == 0:
        raise RuntimeError("Hyprlock output is not in the journal (titan-lock)")
    print(f"PASS  Super+Ctrl+L shows a rendered lock screen (lit {lit:.3f}); Hyprlock logs to the journal", flush=True)

    # Recovery: a killed locker leaves the session locked; relaunching restores it.
    guest(f"sudo pkill -KILL -u {user} -x hyprlock")
    time.sleep(3)
    monitor.screenshot(run / "lock-dead.png")
    if json.loads(guest(prefix + "hyprctl getoption misc:allow_session_lock_restore -j").stdout).get("bool") is not True:
        raise RuntimeError("allow_session_lock_restore is not enabled")
    # The documented TTY rescue (docs/lock-recovery.md), run as the session's user.
    rescue = guest(f"sudo -H -u {user} /usr/share/titan/scripts/lock-rescue")
    if "fresh lock screen is running" not in rescue.stdout:
        raise RuntimeError(f"lock-rescue did not restore the lock: {rescue.stdout}{rescue.stderr}")
    guest(f"sudo -H -u {user} sh -c 'test -s \"$(ls -d ~/.local/state/titan/lock-rescue/* | tail -1)/state.txt\"'")
    wait_for(f"pgrep -u {user} -x hyprlock >/dev/null", 20)
    time.sleep(3)
    lit, _ = lock_frame("lock-restored")
    if not 0.002 < lit < 0.5:
        raise RuntimeError(f"Restored lock is not visibly rendered (lit {lit:.4f})")
    print("PASS  scripts/lock-rescue saves diagnostics and replaces a killed Hyprlock, which renders again", flush=True)

    # pam_faillock: three failures lock the account; the lock screen must say so.
    for _ in range(3):
        monitor.type("wrongpass")
        monitor.key("ret")
        time.sleep(4)
    time.sleep(3)
    _, warning = lock_frame("lock-faillock")
    tally = guest(f"sudo faillock --user {user}").stdout.count(" V")
    if tally < 3 or warning < 20:
        raise RuntimeError(f"Lockout not shown (failures {tally}, warning pixels {warning}); see lock-faillock.png")
    monitor.type("titanvm")
    monitor.key("ret")
    time.sleep(5)
    if not locked():
        raise RuntimeError("The correct password unlocked during a faillock lockout")
    print(f"PASS  after 3 failures the lock screen explains the lockout ({warning} warning pixels)", flush=True)

    guest(f"sudo faillock --user {user} --reset")
    time.sleep(3)
    # Hyprlock's pending PAM attempt began during the lockout, so the first
    # correct password may still be refused (docs/lock-recovery.md); the next works.
    tries = 0
    while locked() and tries < 2:
        monitor.type("titanvm")
        monitor.key("ret")
        tries += 1
        deadline = time.monotonic() + 8
        while locked() and time.monotonic() < deadline:
            time.sleep(1)
    if locked():
        raise RuntimeError("The correct password did not unlock within two tries after the tally was reset")
    time.sleep(2)
    monitor.screenshot(run / "unlocked.png")
    print(f"PASS  the correct password unlocks after the tally is reset (try {tries})", flush=True)
except Exception as error:
    (run / "graphical-error.log").write_text(traceback.format_exc())
    print(f"FAIL  graphical session: {error}", file=sys.stderr)
    sys.exit(1)
finally:
    for name, command in {
        "greetd.log": "sudo journalctl -b -u greetd --no-pager",
        "regreet.log": "sudo cat /var/log/regreet/log",
        "session.log": f"sudo journalctl -b _UID=$(id -u {user}) --no-pager",
        "shell.log": f"sudo -u {user} env XDG_RUNTIME_DIR=/run/user/$(id -u {user}) WAYLAND_DISPLAY=wayland-1 timeout 5 qs -c umbra log",
    }.items():
        try:
            result = guest(command, check=False)
            (run / name).write_text(result.stdout + result.stderr)
        except Exception as error:
            (run / name).write_text(str(error))
