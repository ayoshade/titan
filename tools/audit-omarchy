#!/usr/bin/env python3
"""Inventory a pinned reference checkout without copying its implementation."""
import argparse
from collections import Counter
import hashlib
import json
from pathlib import Path
import subprocess

root = Path(__file__).resolve().parents[1]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('reference', type=Path)
parser.add_argument('--write', action='store_true', help='Update the tracked inventory for the pinned coverage revision')
args = parser.parse_args()
reference = args.reference.expanduser().resolve()
revision = subprocess.run(['git', '-C', str(reference), 'rev-parse', 'HEAD'], check=True, capture_output=True, text=True).stdout.strip()
mapping = json.loads((root / 'docs/research/omarchy-equivalents.json').read_text())
if revision != mapping['revision']:
    parser.error('Reference revision differs from coverage revision; review and update the mapping first')
commands = []
for file in sorted((reference / 'bin').iterdir()):
    if not file.is_file(): continue
    name = file.name
    text = file.read_text(errors='replace')
    summary = next((line.partition('omarchy:summary=')[2].strip() for line in text.splitlines() if line.startswith('# omarchy:summary=')), '')
    coverage = mapping['commands'].get(name, {'status': 'pending', 'equivalent': '', 'notes': 'Behavioral review and implementation remain; no parity claimed.'})
    commands.append({'command': name, 'sha256': hashlib.sha256(file.read_bytes()).hexdigest(),
                     'summary': summary, **coverage})
files = []
for directory in ('config', 'default', 'install', 'shell', 'manual', 'themes'):
    for file in sorted((reference / directory).rglob('*')):
        if file.is_file() and not file.is_symlink():
            files.append({'path': str(file.relative_to(reference)), 'sha256': hashlib.sha256(file.read_bytes()).hexdigest()})
inventory = {'schema': 1, 'source': 'https://github.com/omacom/omarchy', 'revision': revision,
             'counts': dict(Counter(item['status'] for item in commands)), 'commands': commands, 'files': files}
if args.write:
    (root / 'docs/research/omarchy-inventory.json').write_text(json.dumps(inventory, indent=2) + '\n')
print(json.dumps({'revision': revision, 'commands': len(commands), 'files': len(files), 'counts': inventory['counts']}, indent=2))
