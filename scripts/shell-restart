#!/usr/bin/env bash
set -euo pipefail
if [[ -z ${WAYLAND_DISPLAY:-} ]]; then
 read -r HYPRLAND_INSTANCE_SIGNATURE WAYLAND_DISPLAY < <(hyprctl instances -j | python -c 'import json,sys; a=json.load(sys.stdin); print(a[0]["instance"],a[0]["wl_socket"]) if a else sys.exit(1)')
 export HYPRLAND_INSTANCE_SIGNATURE WAYLAND_DISPLAY
fi
export QT_QPA_PLATFORM=wayland
pids=$(qs -c umbra list 2>/dev/null | awk '/Process ID:/{print $3}' || true)
# Quickshell 0.3.1 can deadlock while exiting after `qs kill` (seen 2026-10-03),
# which left the old instance holding the lock. Ask politely, then escalate.
timeout 3 qs -c umbra kill >/dev/null 2>&1 || true
for signal in none TERM KILL; do
 [[ $signal == none ]] || for pid in $pids; do kill -s "$signal" "$pid" 2>/dev/null || true; done
 for attempt in {1..20}; do
  alive=0; for pid in $pids; do kill -0 "$pid" 2>/dev/null && alive=1; done
  ((alive)) || break 2
  sleep 0.1
 done
done
# Launch through the compositor so logind/polkit see the desktop's session,
# even when this recovery script was invoked from a different TTY.
exec hyprctl dispatch 'hl.dsp.exec_cmd("qs -n -d -c umbra")'
