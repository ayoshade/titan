# Add conveniences only when the name has not already been customized.
_titan_alias() { alias "$1" &>/dev/null || declare -F "$1" &>/dev/null || alias "$1=$2"; }
if command -v eza >/dev/null; then
 _titan_alias ls 'eza --group-directories-first'
 _titan_alias lsa 'eza -a --group-directories-first'
 _titan_alias lt 'eza --tree --level=2'
 _titan_alias lta 'eza -a --tree --level=2'
fi
command -v bat >/dev/null && _titan_alias cat 'bat --paging=never'
_titan_alias g git
_titan_alias gs 'git status --short --branch'
_titan_alias gc 'git commit'
_titan_alias gdif 'git diff'
_titan_alias .. 'cd ..'
_titan_alias ... 'cd ../..'
unset -f _titan_alias
