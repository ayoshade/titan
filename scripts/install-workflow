#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
mapfile -t packages < "$root/packages/workflow.txt"
sudo pacman -Syu --needed "${packages[@]}"
"$root/bin/workflow" clipboard-start
printf '\nTitan shortcut dependencies installed. No reboot needed.\n'
