#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
source "$root/lib/titan/boot.sh"
source "$root/lib/titan/snapshot_restore.sh"
case ${1:-} in
 list)
  if [[ $# == 1 || ( $# == 2 && $2 == --json ) ]]; then titan_snapshot_list
  elif [[ ( $# == 3 && $2 == --disk ) || ( $# == 4 && $2 == --disk && $4 == --json ) ]]; then titan_snapshot_restore inventory "$3"
  else echo 'Usage: titan snapshot list [--json] | list --disk DEVICE [--json] (live ISO)' >&2; exit 2
  fi ;;
 create)
  [[ $# == 1 || ( $# == 3 && $2 == --description ) ]] || { echo 'Usage: sudo titan snapshot create [--description TEXT]' >&2; exit 2; }
 titan_snapshot_create "${3:-Manual recovery preview}" ;;
 restore)
  [[ $# == 4 && $3 == --disk && $2 =~ ^[0-9]{8}T[0-9]{6}Z-[a-zA-Z0-9]{6}$ ]] || { echo 'Usage: titan snapshot restore ID --disk DEVICE (live ISO only)' >&2; exit 2; }
  titan_snapshot_restore restore "$4" "$2" ;;
 restore-status|restore-resume)
  [[ ( $# == 3 && $2 == --disk ) || ( $1 == restore-status && $# == 4 && $2 == --disk && $4 == --json ) ]] || { echo 'Usage: titan snapshot restore-status --disk DEVICE [--json] | restore-resume --disk DEVICE' >&2; exit 2; }
  action=status; [[ $1 != restore-resume ]] || action=resume
  titan_snapshot_restore "$action" "$3" ;;
 -h|--help|help) echo 'Usage: titan snapshot list [--disk DEVICE] [--json] | create [--description TEXT] | restore ID --disk DEVICE | restore-status --disk DEVICE [--json] | restore-resume --disk DEVICE (disk inspection/restore requires the live UEFI QEMU ISO)' ;;
 *) echo 'Usage: titan snapshot list|create|restore|restore-status|restore-resume (see --help)' >&2; exit 2 ;;
esac
