#!/usr/bin/env python3
"""Interactive maintenance terminal; commands remain argv, never shell source."""
import shlex
import subprocess
import sys
from pathlib import Path

root = Path(__file__).resolve().parents[1]


def main(argv):
    if argv[:1] == ['--dialog']:
        if len(argv) != 2: raise ValueError('Supply one dialog name')
        if argv[1] == 'webapp':
            argv = ['webapp', 'install', input('App name: '), input('HTTP(S) URL: '), '--icon', input('Icon name [web-browser]: ') or 'web-browser']
        elif argv[1] == 'package-search': argv = ['pkg', 'search', input('Search packages: ')]
        elif argv[1] == 'package-add': argv = ['pkg', 'add', *shlex.split(input('Package names: '))]
        elif argv[1] == 'package-remove': argv = ['pkg', 'remove', *shlex.split(input('Package names: '))]
        else: raise ValueError('Unknown maintenance dialog')
    print('Titan ' + shlex.join(argv), flush=True)
    return subprocess.run([str(root / 'bin/titan'), *argv]).returncode


if __name__ == '__main__':
    try: code = main(sys.argv[1:])
    except (ValueError, EOFError, OSError) as error:
        print(error, file=sys.stderr); code = 1
    except KeyboardInterrupt: code = 130
    if sys.stdin.isatty():
        try: input('\nPress Enter to close this maintenance terminal. ')
        except (EOFError, KeyboardInterrupt): pass
    raise SystemExit(code)
