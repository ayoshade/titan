#!/usr/bin/env bash
# vm-test [--full] [--keep] [--memory MB]: install the built Titan packages on a throwaway Arch
# VM and check them. Never touches this machine's system.
#   - boots Arch's official cloud image (cached in ~/.cache/titan/vm) under
#     QEMU/KVM, headless, on a disposable overlay disk
#   - injects a throwaway SSH key with cloud-init (NoCloud over QEMU's network)
#   - builds an edge repository from this checkout, installs `titan`
#     (`titan-desktop` too with --full), runs `titan setup` as the VM user,
#     verifies the Hyprland config, lints the shell and runs `titan doctor`-style checks
# Requires: qemu-base (sudo pacman -S qemu-base) and /dev/kvm.
set -euo pipefail
root=$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
full=0 keep=0 memory=2048
while (($#)); do case $1 in --full) full=1; shift ;; --keep) keep=1; shift ;; --memory) memory=$2; shift 2 ;; *) sed -n 2,12p "$0"; exit 2 ;; esac; done
command -v qemu-system-x86_64 >/dev/null || { echo "vm-test: install QEMU first: sudo pacman -S qemu-base" >&2; exit 1; }
[[ -w /dev/kvm ]] || { echo "vm-test: /dev/kvm is not available" >&2; exit 1; }
cache=${XDG_CACHE_HOME:-$HOME/.cache}/titan/vm
mkdir -p "$cache/runs"
# The overlay disk grows by gigabytes: keep it on disk, never in a RAM-backed /tmp.
run=$(mktemp -d "$cache/runs/run.XXXXXX")
# The host must keep enough memory for itself, or its OOM killer ends the VM.
available=$(awk '/MemAvailable/{print int($2/1024)}' /proc/meminfo)
if (( available < memory + 1024 )); then
 echo "vm-test: only ${available} MB available; need ${memory} MB for the VM plus 1 GB for this machine." >&2
 echo "         Close some applications or use --memory with a smaller value (at least 1536)." >&2
 rm -rf "$run"; exit 1
fi
image=$cache/Arch-Linux-x86_64-cloudimg.qcow2
base=https://geo.mirror.pkgbuild.com/images/latest
if [[ ! -e $image ]]; then
 echo "Downloading the Arch cloud image (≈550 MB, cached)…"
 curl -fL --progress-bar -o "$image.part" "$base/Arch-Linux-x86_64-cloudimg.qcow2"
 curl -fsL -o "$cache/image.SHA256" "$base/Arch-Linux-x86_64-cloudimg.qcow2.SHA256"
 (cd "$cache" && sed 's/  .*/  Arch-Linux-x86_64-cloudimg.qcow2.part/' image.SHA256 | sha256sum -c --quiet)
 mv "$image.part" "$image"
fi
qemu-img create -q -f qcow2 -b "$image" -F qcow2 "$run/disk.qcow2" 24G
ssh-keygen -q -t ed25519 -N '' -f "$run/key"
mkdir -p "$run/seed"
printf 'instance-id: titan-vm-test\nlocal-hostname: titan-test\n' >"$run/seed/meta-data"
cat >"$run/seed/user-data" <<EOF
#cloud-config
users:
  - name: tester
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    ssh_authorized_keys: [$(cat "$run/key.pub")]
growpart: {mode: auto, devices: ['/']}
EOF
# Packages to test, built from this checkout.
"$root/scripts/build-repo" --channel edge "$run/repo" >/dev/null
port=$((20000 + RANDOM % 20000)) sshport=$((40000 + RANDOM % 20000))
python3 -m http.server "$port" --bind 127.0.0.1 --directory "$run/seed" >/dev/null 2>&1 &
http=$!
cleanup() {
 kill "$http" 2>/dev/null || true
 [[ -e $run/qemu.pid ]] && kill "$(cat "$run/qemu.pid")" 2>/dev/null || true
 ((keep)) || rm -rf "$run"
}
trap cleanup EXIT
qemu-system-x86_64 -enable-kvm -cpu host -m "$memory" -smp 4 -display none -daemonize -pidfile "$run/qemu.pid" \
 -drive file="$run/disk.qcow2",if=virtio \
 -nic user,model=virtio-net-pci,hostfwd=tcp:127.0.0.1:$sshport-:22 \
 -smbios type=1,serial="ds=nocloud;s=http://10.0.2.2:$port/" \
 -serial file:"$run/console.log"
ssh_vm() { ssh -q -i "$run/key" -p "$sshport" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=5 tester@127.0.0.1 "$@"; }
echo "Booting the VM…"
for i in $(seq 1 90); do ssh_vm true 2>/dev/null && break; sleep 3; done
ssh_vm true || { echo "vm-test: the VM did not come up; console log: $run/console.log" >&2; keep=1; exit 1; }
scp -q -i "$run/key" -P "$sshport" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "$run"/repo/*.pkg.tar.zst tester@127.0.0.1:
pkgs="titan-[0-9]*-any.pkg.tar.zst"; ((full)) && pkgs="titan-[0-9]*-any.pkg.tar.zst titan-desktop-*-any.pkg.tar.zst"
# The install runs as a detached unit inside the VM: package hooks may restart
# services and drop SSH, so it must not depend on one connection staying open.
echo "Installing inside the VM (detached job; full update first)…"
ssh_vm "sudo systemd-run --unit=titan-vmtest-install --property=Type=oneshot --no-block \
 /bin/bash -c 'set -e; pacman-key --init; pacman-key --populate archlinux; pacman -Syu --noconfirm; cd /home/tester; pacman -U --noconfirm $pkgs; touch /var/tmp/titan-install.ok'"
state=activating
vm_alive() { kill -0 "$(cat "$run/qemu.pid")" 2>/dev/null; }
for i in $(seq 1 360); do
 vm_alive || { echo "vm-test: the VM stopped during the install. Check the host log for an OOM kill: journalctl -k | grep -i oom" >&2; keep=1; exit 1; }
 state=$(ssh_vm systemctl is-active titan-vmtest-install 2>/dev/null || true)
 [[ $state == activating || -z $state ]] || break
 sleep 5
done
if ! ssh_vm test -e /var/tmp/titan-install.ok; then
 echo "vm-test: the install job did not succeed (state: ${state:-unknown}). Its log:" >&2
 ssh_vm sudo journalctl -u titan-vmtest-install --no-pager | tail -40 >&2 || true
 keep=1; exit 1
fi
echo "Checking inside the VM…"
status=0
ssh_vm bash -s <<EOF || status=$?
set -euo pipefail
pass() { printf 'PASS  %s\n' "\$1"; }
fail() { printf 'FAIL  %s\n' "\$1"; failed=1; }
failed=0
pass "pacman installed $pkgs after a full update"
command -v titan >/dev/null && pass "titan on PATH" || fail "titan on PATH"
titan version
titan setup >/dev/null && pass "titan setup (first run)" || fail "titan setup"
titan setup >/dev/null && pass "titan setup is repeatable" || fail "titan setup repeat"
[[ \$(titan theme current) == graphite ]] && pass "default theme graphite" || fail "default theme"
titan migrate --status | grep -q pending && fail "migrations pending on a fresh install" || pass "fresh install has no pending migrations"
[[ -e ~/.config/titan/preferences.json && -e ~/.local/state/titan/generated/kitty-theme.conf ]] && pass "user layer and generated theme" || fail "user layer"
grep -q /usr/share/titan/config/kitty/kitty.conf ~/.config/kitty/kitty.conf && pass "thin Kitty config" || fail "thin Kitty config"
[[ -e /etc/xdg/quickshell/umbra/shell.qml ]] && pass "shell registered in /etc/xdg" || fail "shell path"
[[ -e /usr/share/wayland-sessions/titan.desktop ]] && pass "Titan login session" || fail "session file"
TITAN_ROOT=/usr/share/titan Hyprland --verify-config -c /usr/share/titan/config/hypr/hyprland.lua 2>&1 | grep -q "config ok" && pass "Hyprland accepts the packaged config" || fail "Hyprland config"
if /usr/lib/qt6/bin/qmllint -I /usr/lib/qt6/qml /usr/share/titan/config/quickshell/umbra/shell.qml 2>&1 | grep -qE "^Error"; then fail "shell QML"; else pass "shell QML parses"; fi
titan settings set islandWidth 260 && [[ \$(titan settings get islandWidth) == 260 ]] && pass "settings round-trip" || fail "settings"
titan theme nord >/dev/null && [[ \$(titan theme current) == nord ]] && pass "theme switch" || fail "theme switch"
exit \$failed
EOF
((status == 0)) && echo "All VM checks passed." || echo "Some VM checks failed."
exit $status
